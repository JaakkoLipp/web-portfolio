---
import Base from '../layouts/Base.astro';
import '../styles/terminal.css';
import { site } from '../site.config';
import { getTerminalData, toScriptJson } from '../lib/terminal-data';
import { SHELL } from '../lib/site';

const data = await getTerminalData();
const { owner, links, pages } = site;
---

<Base title={`${owner.name}, ${owner.role}`} bodyClass="tty">
  <noscript slot="head"><style>#app { display: none; } body.tty { overflow: auto; }</style></noscript>

  <div class="sr-only">
    <h1>{owner.name}, {owner.role}</h1>
    <p>{owner.focus}. {owner.location}.</p>
    <nav aria-label="Pages">
      <ul>
        {pages.map((p) => <li><a href={p.path}>{p.title}</a></li>)}
        {links.map((l) => <li><a href={l.url} rel="me noopener">{l.label}</a></li>)}
      </ul>
    </nav>
  </div>

  <noscript>
    <div class="nojs">
      <h1>{owner.name}</h1>
      <p>{owner.role}. {owner.focus}. {owner.location}.</p>
      <p>The homepage is a terminal and needs JavaScript. Everything else works without it:</p>
      <ul>
        {pages.map((p) => <li><a href={p.path}>{p.title}</a>: {p.blurb}</li>)}
      </ul>
      <p>{links.map((l, i) => <>{i > 0 && ' · '}<a href={l.url} rel="me noopener">{l.label}</a></>)}</p>
    </div>
  </noscript>

  <div id="app">
    <main id="term" aria-label="Terminal">
      <div id="screen">
        <div id="out" role="log" aria-live="off"></div>
        <div id="cmdLine" hidden>
          <span id="prompt"></span><input
            id="cmd"
            type="text"
            aria-label="Command"
            autocomplete="off"
            autocapitalize="off"
            autocorrect="off"
            spellcheck="false"
            enterkeyhint="go"
          />
        </div>
      </div>
    </main>

    <div id="bottom">
      <div id="status">
        <span><span class="win">0:{SHELL}*</span>[{site.brand}]</span>
        <span id="statusMid"></span>
        <span id="clock"></span>
      </div>
    </div>
  </div>

  <div id="overlay" role="dialog" aria-label="htop process viewer" hidden>
    <div id="ovBody"></div>
    <div id="ovKeys">
      <span class="fk">F1</span><span class="fl">Help</span>
      <span class="fk">F3</span><span class="fl">Search</span>
      <span class="fk">F6</span><span class="fl">SortBy</span>
      <span class="fk">F9</span><span class="fl">Kill</span>
      <button id="ovQuit" type="button" aria-label="Quit htop"><span class="fk">F10</span><span class="fl">Quit</span></button>
    </div>
  </div>

  <script is:inline type="application/json" id="term-data" set:html={toScriptJson(data)} />
  <script>
    import '../scripts/terminal/main.js';
  </script>
</Base>
